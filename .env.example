FOLIO_DOMAIN=papers.example.com
# Generate this with server/password.mjs. Never put your plaintext password here.
FOLIO_PASSWORD_HASH=

# Owner username on the first multi-user startup (existing password and library retained).
FOLIO_OWNER_USERNAME=owner

# Optional server-only automatic collection tagging. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=100
AI_USER_DAILY_LIMIT=20
